<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: pedida em tempo de execução depois de entrar (MainActivity). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Presença (opcional, desligada por omissão; ver README "Presença"). Pedidas só depois do ecrã
         que explica porquê: localização precisa, depois "Permitir sempre" (Android 10+). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Ler o nome (SSID) do Wi-Fi atual, para "ligado ao Wi-Fi de casa". -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Voltar a registar a zona de casa depois de reiniciar o telemóvel. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".DomusApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Domus">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Presença: entradas/saídas da zona de casa (Geofencing) e novo registo depois de reiniciar. -->
        <receiver
            android:name=".presenca.ZonaReceiver"
            android:exported="false" />
        <receiver
            android:name=".presenca.ArranqueReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Firebase Cloud Messaging (só ativo se existir app/google-services.json; ver android/README.md). -->
        <service
            android:name=".notificacoes.DomusMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="avisos" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notificacao" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/musgo" />
    </application>
</manifest>
