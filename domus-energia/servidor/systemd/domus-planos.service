# Domus Energia — permissões (ACL) dos planos, a cada minuto:
#   clientes suspensos ou cancelados ficam só com leitura do próprio _plano
#   (docs/PROTOCOLO-PLANOS.md §3–§4). Só recarrega o Mosquitto quando muda algo.
# Corrido por domus-planos.timer. Os pedidos do painel têm o seu próprio
# temporizador, a cada 5 s (domus-pedidos.timer).
# O instalar.sh instala isto sozinho. À mão: ver servidor/README.md, "Planos e
# pagamentos", e trocar /home/ubuntu/domus-energia/servidor pela pasta
# servidor/ do seu VPS (nas duas linhas abaixo).
[Unit]
Description=Domus Energia: permissões MQTT dos planos
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/domus-energia/servidor
ExecStart=/home/ubuntu/domus-energia/servidor/domus.sh sincronizar-planos
# Não deixar uma execução presa (espera no máximo 50 s pelo cadeado).
TimeoutStartSec=120
Nice=10
# A cada minuto o systemd escreveria "Starting/Finished" no journal (~2900
# linhas por dia). Como no domus-pedidos.service: o que o domus.sh escreve
# passa a "notice" e só se guarda daí para cima (as mudanças de ACL e as falhas).
SyslogLevel=notice
LogLevelMax=notice
