# Domus Energia — Caddy
# HTTPS automático (Let's Encrypt / ZeroSSL) para DOMUS_HOST e ntfy.DOMUS_HOST.
#   https://HOST/            -> site estático (pasta ../web)
#   wss://HOST/mqtt          -> Mosquitto (WebSocket, porta interna 9001)
#   https://HOST/api/*       -> pagamentos (sessão, checkout, portal; porta interna 8080)
#   https://HOST/stripe/webhook -> pagamentos (eventos do Stripe, assinados)
#   https://HOST/api/orcamento  -> painel (formulário público; ANTES da regra /api/*)
#   https://HOST/api/orcamento/fotos -> painel (fotos do simulador, ≤ 1 MB cada; idem)
#   https://HOST/api/catalogo   -> painel (catálogo público do simulador; idem)
#   https://HOST/api/conta/*    -> painel (conta de cliente, docs/CONTA-CLIENTE.md; idem), incluindo os
#                                  pagamentos do pedido /api/conta/pagamentos/* e o webhook do Stripe deles
#                                  /api/conta/pagamentos/stripe-webhook (docs/PAGAMENTOS-PEDIDO.md)
#   https://HOST/painel/...     -> painel da empresa (ecrãs e /painel/api/)
#   https://HOST/ntfy/...    -> redireciona para https://ntfy.HOST/...
#   https://ntfy.HOST/       -> ntfy (notificações)
#
# Porque é que o ntfy está num subdomínio e não em /ntfy? O ntfy não suporta
# ser servido num sub-caminho: recusa arrancar com base-url com caminho
# ("hosting ntfy on a sub-path is not supported") e a app web dele pede sempre
# os ficheiros a partir de "/". Com sslip.io o subdomínio funciona sozinho
# (ntfy.51-38-10-20.sslip.io aponta para 51.38.10.20); com domínio próprio é
# preciso um registo DNS para ntfy.<domínio> (ver README).

{$DOMUS_HOST} {
	@mqtt path /mqtt /mqtt/*
	handle @mqtt {
		reverse_proxy mosquitto:9001
	}

	# Serviço de pagamentos (docs/PROTOCOLO-PLANOS.md §4). O Caddy substitui o
	# X-Forwarded-For pelo IP real do visitante (usado no limite de tentativas).
	# O webhook do Stripe precisa do corpo exatamente como chegou (assinatura):
	# o Caddy não o altera. Mesmo site = mesma origem: "connect-src 'self'" da
	# CSP já cobre o /api, e não é preciso CORS.
	# Painel da empresa (docs/PAINEL-EMPRESA.md). Os blocos "handle" correm pela
	# ordem em que aparecem: /api/orcamento e /api/catalogo têm de vir ANTES da
	# regra /api/* dos pagamentos. O pedido de orçamento pode trazer a simulação
	# (planta com imagem, até 1 MB): limite de 2 MB aqui, 1,25 MB no serviço.
	# As fotos do simulador vão a seguir, uma a uma, para /api/orcamento/fotos (≤ 1 MB cada).
	# A conta de cliente (/api/conta/*: criar/entrar, simulação guardada até 1,5 MB, fotos ≤ 1 MB) também é do painel.
	@orcamento path /api/orcamento /api/orcamento/fotos /api/catalogo /api/conta/*
	handle @orcamento {
		request_body {
			max_size 2MB
		}
		reverse_proxy painel:8080
	}

	@painel path /painel /painel/*
	handle @painel {
		request_body {
			max_size 1MB
		}
		reverse_proxy painel:8080
	}

	@pagamentos path /api/* /stripe/webhook
	handle @pagamentos {
		request_body {
			max_size 1MB
		}
		reverse_proxy pagamentos:8080
	}

	# Compatibilidade com o formato https://HOST/ntfy/<tópico> do protocolo v2.
	handle_path /ntfy/* {
		redir https://ntfy.{$DOMUS_HOST}{uri} 302
	}
	redir /ntfy https://ntfy.{$DOMUS_HOST}/ 302

	# config.js gerado pelo instalar.sh (mqttUrl com o DOMUS_HOST deste servidor)
	# em servidor/config-site/, fora do git. Sem esse ficheiro serve-se o web/config.js.
	@configsite {
		path /config.js
		file {
			root /srv/config-site
		}
	}
	handle @configsite {
		root * /srv/config-site
		file_server
	}

	handle {
		root * /srv/web
		encode zstd gzip
		file_server
	}

	# Segurança do site e da área de cliente:
	# - ninguém pode pôr as páginas dentro de um <iframe> (clickjacking);
	# - CSP: scripts só do próprio site e do cdn.jsdelivr.net (mqtt.js e o
	#   pdf.js do simulador); estilos próprios + Google Fonts ('unsafe-inline'
	#   porque há atributos style="" e variáveis CSS postas pelo JavaScript);
	#   ligações só ao próprio site (inclui o /api dos pagamentos e o
	#   /api/orcamento do painel) e ao MQTT (wss://HOST/mqtt). O Stripe Checkout e o Customer
	#   Portal abrem por navegação (location.href), que a CSP não restringe: não
	#   é preciso acrescentar o stripe.com. O painel (/painel/) envia ainda a sua
	#   própria CSP, mais apertada (sem CDN nem MQTT no navegador); o navegador
	#   aplica as duas.
	#   Se mudar de CDN ou de fontes, atualize esta linha.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; worker-src 'self' blob: https://cdn.jsdelivr.net; connect-src 'self' wss://{$DOMUS_HOST}; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
	}

	log {
		output stdout
		format console
	}
}

ntfy.{$DOMUS_HOST} {
	# O ntfy usa ligações longas (WebSocket/stream); o Caddy trata disso sozinho.
	reverse_proxy ntfy:80

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	log {
		output stdout
		format console
	}
}
