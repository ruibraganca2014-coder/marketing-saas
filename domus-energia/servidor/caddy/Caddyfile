# Domus Energia — Caddy
# HTTPS automático (Let's Encrypt / ZeroSSL) para DOMUS_HOST e ntfy.DOMUS_HOST.
#   https://HOST/            -> site estático (pasta ../web)
#   wss://HOST/mqtt          -> Mosquitto (WebSocket, porta interna 9001)
#   https://HOST/api/*       -> pagamentos (sessão, checkout, portal; porta interna 8080)
#   https://HOST/stripe/webhook -> pagamentos (eventos do Stripe, assinados)
#   https://HOST/api/orcamento  -> painel (formulário público; ANTES da regra /api/*)
#   https://HOST/api/orcamento/fotos -> painel (fotos do simulador, ≤ 1 MB cada; idem)
#   https://HOST/api/catalogo   -> painel (catálogo público do simulador; idem)
#   https://HOST/api/fotos-remotas* -> painel (fotos pelo telemóvel via QR, web/foto.html; idem)
#   https://HOST/api/conta/*    -> painel (conta de cliente, docs/CONTA-CLIENTE.md; idem), incluindo os
#                                  pagamentos do pedido /api/conta/pagamentos/* e o webhook do Stripe deles
#                                  /api/conta/pagamentos/stripe-webhook (docs/PAGAMENTOS-PEDIDO.md)
#   https://HOST/api/eletricista/* -> painel (eletricistas externos, docs/ELETRICISTAS.md; idem): candidatura com o
#                                  documento do seguro (até 5 MB) e a área do eletricista
#   https://HOST/painel/...     -> painel da empresa (ecrãs e /painel/api/)
#   https://HOST/ntfy/...    -> redireciona para https://ntfy.HOST/...
#   https://ntfy.HOST/       -> ntfy (notificações)
#
# Porque é que o ntfy está num subdomínio e não em /ntfy? O ntfy não suporta
# ser servido num sub-caminho: recusa arrancar com base-url com caminho
# ("hosting ntfy on a sub-path is not supported") e a app web dele pede sempre
# os ficheiros a partir de "/". Com sslip.io o subdomínio funciona sozinho
# (ntfy.51-38-10-20.sslip.io aponta para 51.38.10.20); com domínio próprio é
# preciso um registo DNS para ntfy.<domínio> (ver README).

# Opções globais (decisão do dono, 2026-10-24): HTTP/3 desligado — só HTTP/1.1 e HTTP/2 (TCP). Com o Alt-Svc: h3 e o
# UDP 443 sem resposta, os navegadores que tentavam o QUIC primeiro chegavam a esperar ~10 s (auditoria de 2026-10-24;
# Chrome forçado ao QUIC: ERR_QUIC_PROTOCOL_ERROR). O docker-compose.yml já não publica a 443/udp.
{
	servers {
		protocols h1 h2
	}
}

{$DOMUS_HOST} {
	@mqtt path /mqtt /mqtt/*
	handle @mqtt {
		reverse_proxy mosquitto:9001
	}

	# Serviço de pagamentos (docs/PROTOCOLO-PLANOS.md §4). O Caddy substitui o
	# X-Forwarded-For pelo IP real do visitante (usado no limite de tentativas).
	# O webhook do Stripe precisa do corpo exatamente como chegou (assinatura):
	# o Caddy não o altera. Mesmo site = mesma origem: "connect-src 'self'" da
	# CSP já cobre o /api, e não é preciso CORS.
	# Painel da empresa (docs/PAINEL-EMPRESA.md). Os blocos "handle" correm pela
	# ordem em que aparecem: /api/orcamento e /api/catalogo têm de vir ANTES da
	# regra /api/* dos pagamentos. O pedido de orçamento pode trazer a simulação
	# (planta com imagem, até 1 MB): limite de 2 MB aqui, 1,25 MB no serviço.
	# As fotos do simulador vão a seguir, uma a uma, para /api/orcamento/fotos (≤ 1 MB cada).
	# A conta de cliente (/api/conta/*: criar/entrar, simulação guardada até 1,5 MB, fotos ≤ 1 MB) também é do painel.
	@orcamento path /api/orcamento /api/orcamento/fotos /api/catalogo /api/conta/* /api/fotos-remotas /api/fotos-remotas/*
	handle @orcamento {
		# O catálogo é público e igual para todos: vai comprimido (as respostas das contas não).
		@catalogo path /api/catalogo
		encode @catalogo zstd gzip
		request_body {
			max_size 2MB
		}
		reverse_proxy painel:8080
	}

	# Eletricistas externos (docs/ELETRICISTAS.md): a candidatura leva o documento do seguro em base64 (5 MB → ~6,7 MB
	# de JSON; o serviço volta a verificar o tamanho e o tipo pelos bytes). ANTES da regra /api/* dos pagamentos.
	@eletricista path /api/eletricista/*
	handle @eletricista {
		request_body {
			max_size 8MB
		}
		reverse_proxy painel:8080
	}

	@painel path /painel /painel/*
	handle @painel {
		# Os ficheiros do painel (JS, CSS, HTML) vão comprimidos; as respostas da API, com dados da empresa, não.
		@painelficheiros not path /painel/api/*
		encode @painelficheiros zstd gzip
		request_body {
			max_size 1MB
		}
		reverse_proxy painel:8080
	}

	@pagamentos path /api/* /stripe/webhook
	handle @pagamentos {
		request_body {
			max_size 1MB
		}
		reverse_proxy pagamentos:8080
	}

	# Compatibilidade com o formato https://HOST/ntfy/<tópico> do protocolo v2.
	handle_path /ntfy/* {
		redir https://ntfy.{$DOMUS_HOST}{uri} 302
	}
	redir /ntfy https://ntfy.{$DOMUS_HOST}/ 302

	# config.js gerado pelo instalar.sh (mqttUrl com o DOMUS_HOST deste servidor)
	# em servidor/config-site/, fora do git. Sem esse ficheiro serve-se o web/config.js.
	@configsite {
		path /config.js
		file {
			root /srv/config-site
		}
	}
	handle @configsite {
		root * /srv/config-site
		encode zstd gzip
		header Cache-Control "no-cache"
		file_server
	}

	# Página de pagamento simulado (web/pagamento-simulado.html + .js; docs/PAGAMENTOS-PEDIDO.md): só existe com
	# PAGAMENTOS_MODO=simulado (passado ao caddy pelo docker-compose.yml). Em produção (stripe, ou pagamentos desligados)
	# responde 404, como uma página que não existe (auditoria de 2026-10-24). No computador (local/iniciar.js) o site não
	# passa pelo Caddy e a página continua a funcionar.
	@pagamentosimulado {
		path /pagamento-simulado.html /pagamento-simulado.js
		expression `{env.PAGAMENTOS_MODO} != "simulado"`
	}
	handle @pagamentosimulado {
		error 404
	}

	# Site estático. Sem build nem nomes com hash, o HTML, o JS (módulos ES que se importam uns aos outros) e o CSS
	# revalidam-se sempre (no-cache + ETag → 304 baratos): depois de publicar, ninguém fica com um módulo antigo e
	# outro novo. O que tem nome estável (ícones, imagens, fontes) fica uma semana em cache.
	# O web/sw.js (service worker só dos avisos da app, decisão do dono de 2026-10-14) é um *.js: vai com no-cache e
	# text/javascript, na raiz (âmbito /); a CSP abaixo já o permite (worker-src 'self'); o push não precisa de mais nada.
	handle {
		root * /srv/web
		encode zstd gzip
		@revalidar path / *.html *.js *.mjs *.css *.txt *.xml
		header @revalidar Cache-Control "no-cache"
		@estavel path *.svg *.ico *.png *.jpg *.jpeg *.webp *.woff2 *.mp3
		header @estavel Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
		file_server
	}

	# Página 404 do site (web/404.html) em vez do corpo vazio; os outros erros ficam como o Caddy os dá.
	handle_errors {
		@404 expression {http.error.status_code} == 404
		handle @404 {
			root * /srv/web
			rewrite * /404.html
			file_server
		}
	}

	# Segurança do site e da área de cliente:
	# - ninguém pode pôr as páginas dentro de um <iframe> (clickjacking);
	# - CSP: scripts só do próprio site e, do cdn.jsdelivr.net, só a pasta do pdf.js do simulador na versão usada
	#   (web/simulador/fundo.js PDFJS_VERSAO = 4.10.38: pdf.min.mjs e o worker; o mqtt.js é do próprio site,
	#   web/vendor/mqtt.min.js). SE MUDAR A VERSÃO DO PDF.JS, MUDE-A TAMBÉM AQUI (script-src e worker-src);
	#   estilos próprios + Google Fonts ('unsafe-inline' porque há atributos style="" e variáveis CSS postas pelo
	#   JavaScript);
	#   ligações só ao próprio site (inclui o /api dos pagamentos e o
	#   /api/orcamento do painel) e ao MQTT (wss://HOST/mqtt). O Stripe Checkout e o Customer
	#   Portal abrem por navegação (location.href), que a CSP não restringe: não
	#   é preciso acrescentar o stripe.com. O painel (/painel/) envia ainda a sua
	#   própria CSP, mais apertada (sem CDN nem MQTT no navegador); o navegador
	#   aplica as duas.
	#   Se mudar de CDN ou de fontes, atualize esta linha.
	# - Permissions-Policy: o site não usa microfone, localização, pagamentos no browser, USB nem sensores. A câmara fica
	#   só para o próprio site (as fotos do simulador, de foto.html pelo QR e da app de diagnóstico abrem a câmara pelo
	#   <input type="file" capture>; se um dia usarem getUserMedia continua a funcionar). O ecrã inteiro (editor da planta)
	#   também só o próprio site.
	# - HSTS sem includeSubDomains: o domínio (opancas.pt) pode ter outros subdomínios fora deste servidor;
	#   www e ntfy já têm HTTPS aqui. Só juntar includeSubDomains depois de confirmar que nenhum subdomínio precisa de HTTP.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net/npm/pdfjs-dist@4.10.38/legacy/build/; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; worker-src 'self' blob: https://cdn.jsdelivr.net/npm/pdfjs-dist@4.10.38/legacy/build/; connect-src 'self' wss://{$DOMUS_HOST}; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), accelerometer=(), gyroscope=(), magnetometer=(), fullscreen=(self)"
	}

	# Registo de acessos sem os cabeçalhos sensíveis: os tokens das fotos (X-Foto-Token, 24 h, fotos pelo
	# telemóvel; X-Fotos-Token, 30 min, fotos do pedido), o Cookie (sessões do painel e da conta) e o Authorization.
	# O resto do pedido fica registado como antes.
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>headers>X-Foto-Token delete
				request>headers>X-Fotos-Token delete
				request>headers>Cookie delete
				request>headers>Authorization delete
			}
		}
	}
}

# www.HOST → HOST (308, mantém o caminho). O Caddy emite o certificado sozinho; o registo DNS "www" tem de existir.
www.{$DOMUS_HOST} {
	redir https://{$DOMUS_HOST}{uri} 308
}

ntfy.{$DOMUS_HOST} {
	# O ntfy usa ligações longas (WebSocket/stream); o Caddy trata disso sozinho.
	reverse_proxy ntfy:80

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	log {
		output stdout
		format console
	}
}
